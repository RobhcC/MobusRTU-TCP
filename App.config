<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    =========================================================================
    ModbusRTU_TCP 上位机配置
    =========================================================================
    修改配置后，应用程序需重启才能生效。
    若修改了 connectionStrings 中的数据库路径，请确保目录已存在或程序有创建权限。
  -->

  <configSections>
    <!-- 如需自定义配置节，可在此处声明 -->
  </configSections>

  <!-- ======================== 数据库连接串 ======================== -->
  <connectionStrings>
    <add name="SQLiteConnection"
         connectionString="Data Source=D:\SQLiteData\ModbusRTU_TCP.db;Version=3;Pooling=true;Max Pool Size=10;"
         providerName="System.Data.SQLite" />
  </connectionStrings>

  <!-- ======================== 应用运行参数 ======================== -->
  <appSettings>

    <!-- ─── SQLite 数据库 ─── -->
    <!-- 数据库文件存放目录（DataExportDAL.cs 默认 D:\SQLiteData） -->
    <add key="DatabaseDirectory" value="D:\SQLiteData" />
    <!-- 数据库文件名 -->
    <add key="DatabaseFileName" value="ModbusRTU_TCP.db" />
    <!-- 内存保留的最大记录数（超过后删除最早记录） -->
    <add key="MaxRecordCount" value="1000" />

    <!-- ─── Modbus 通信参数 ─── -->
    <!-- 超时重发最大次数（ModbusBLL.cs 默认 3） -->
    <add key="MaxRetryCount" value="3" />
    <!-- 单次最大读取寄存器数（Modbus 协议限制，ModbusBLL.cs 默认 125） -->
    <add key="MaxReadRegisterCount" value="125" />
    <!-- 单次最大写入寄存器数（Modbus 协议限制，ModbusBLL.cs 默认 123） -->
    <add key="MaxWriteRegisterCount" value="123" />
    <!-- 默认从站地址（ModbusBLL.cs 默认 1） -->
    <add key="DefaultSlaveAddress" value="1" />
    <!-- 默认起始寄存器地址（ModbusBLL.cs 默认 0） -->
    <add key="DefaultStartAddress" value="0" />
    <!-- 默认读取寄存器数量（Form1.cs 默认 2：温度 + 湿度） -->
    <add key="DefaultReadCount" value="2" />

    <!-- ─── TCP 连接参数 ─── -->
    <!-- TCP 超时时间（毫秒，ModbusBLL.cs 默认 5000） -->
    <add key="TcpTimeoutMs" value="5000" />
    <!-- TCP 接收缓冲区大小（字节，ModbusBLL.cs 默认 1024） -->
    <add key="TcpBufferSize" value="1024" />
    <!-- 默认目标 IP 地址（Form1.Designer.cs 默认 127.0.0.1） -->
    <add key="DefaultTcpIp" value="127.0.0.1" />
    <!-- 默认目标端口（Form1.Designer.cs 默认 502） -->
    <add key="DefaultTcpPort" value="502" />

    <!-- ─── 串口默认参数 ─── -->
    <!-- 默认波特率（Form1.cs 默认 9600） -->
    <add key="DefaultBaudRate" value="9600" />
    <!-- 可用波特率列表（逗号分隔） -->
    <add key="BaudRateOptions" value="9600,19200,38400,57600,115200" />

    <!-- ─── 定时器间隔 ─── -->
    <!-- 自动采集定时器间隔（毫秒，Form1.cs 默认 3000） -->
    <add key="AutoSendIntervalMs" value="3000" />
    <!-- 接收轮询定时器间隔（毫秒，Form1.Designer.cs 默认 1000） -->
    <add key="ReceivePollIntervalMs" value="1000" />
    <!-- 超时定时器间隔（毫秒，Form1.Designer.cs 默认 5000） -->
    <add key="TimeOutIntervalMs" value="5000" />

    <!-- ─── 指数退避重连 ─── -->
    <!-- 重连基础等待时间（毫秒，ModbusBLL.cs 默认 1000 = 1s） -->
    <add key="ExponentialBackoffBaseMs" value="1000" />
    <!-- 重连最大等待时间（毫秒，ModbusBLL.cs 默认 30000 = 30s） -->
    <add key="ExponentialBackoffMaxMs" value="30000" />

    <!-- ─── 温湿度阈值 ─── -->
    <!-- 高温报警阈值（摄氏度，ModbusBLL.cs 默认 35） -->
    <add key="HighTempThreshold" value="35" />
    <!-- 低温报警阈值（摄氏度，ModbusBLL.cs 默认 10） -->
    <add key="LowTempThreshold" value="10" />
    <!-- 湿度偏高阈值（百分比，Form1.cs 默认 80） -->
    <add key="HighHumidityThreshold" value="80" />
    <!-- 湿度偏低阈值（百分比，Form1.cs 默认 30） -->
    <add key="LowHumidityThreshold" value="30" />

    <!-- ─── 日志与导出 ─── -->
    <!-- 日志时间格式 -->
    <add key="LogTimeFormat" value="yyyy/MM/dd:HH:mm:ss" />
    <!-- 导出文件默认编码 -->
    <add key="ExportEncoding" value="UTF-8" />

    <!-- ─── 窗体设置 ─── -->
    <!-- 窗口标题（Form1.Designer.cs 默认 "Modbus温湿度采集系统 - 批量读写版"） -->
    <add key="FormTitle" value="Modbus温湿度采集系统 - 批量读写版" />
    <!-- 窗口宽度（Form1.Designer.cs 默认 800） -->
    <add key="FormWidth" value="800" />
    <!-- 窗口高度（Form1.Designer.cs 默认 550） -->
    <add key="FormHeight" value="550" />

  </appSettings>

  <!-- ======================== .NET Framework 运行时 ======================== -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!-- ======================== 运行时设置 ======================== -->
  <runtime>
    <!-- 当从 .NET Framework 4.0+ 切换到 4.5+ 时，启用一些新特性 -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false" />
  </runtime>

  <!-- ======================== System.Data.SQLite 相关 ======================== -->
  <system.data>
    <DbProviderFactories>
      <remove invariant="System.Data.SQLite" />
      <add name="SQLite Data Provider"
           invariant="System.Data.SQLite"
           description=".NET Framework Data Provider for SQLite"
           type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
    </DbProviderFactories>
  </system.data>

</configuration>